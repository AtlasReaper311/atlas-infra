# Copy this file into the protected local runtime area only after approval.
# Leave all secret values absent from source control and this example.
RAG_SECRET_ROOT=U:/runtime-secrets/rag-estate
RAG_TLS_ROOT=U:/runtime-secrets/rag-estate/tls

# RAG_TLS_ROOT is the protected source directory. Before Compose starts,
# the approved installation step must copy ca.pem, cert.pem, and key.pem into
# the Docker-managed qdrant-tls volume with non-root-readable permissions.
# Compose mounts that named volume read-only; it does not bind Windows TLS
# files directly into non-root containers.

# Every image ref must be name@sha256:<64 hex characters>.
QDRANT_IMAGE_REF=
RAMONE_MEMORY_IMAGE_REF=
ATLAS_CORPUS_IMAGE_REF=
OLLAMA_RAG_KIT_IMAGE_REF=

# The runtime must choose the state explicitly. The freeze overlay forces true.
WRITE_FREEZE=true
RAMONE_MEMORY_HOST_PORT=8091
ATLAS_CORPUS_HOST_PORT=8092
OLLAMA_RAG_KIT_HOST_PORT=8093
