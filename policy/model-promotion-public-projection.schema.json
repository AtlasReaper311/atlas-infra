{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atlas-systems.uk/policy/v1/model-promotion-public-projection.schema.json",
  "title": "Atlas Systems public Model Promotion projection policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "contract_schema", "lifecycle_authority", "allowed_capability_ids", "allowed_model_identifiers", "allowed_suite_versions", "regression_vocabulary", "public_boundary", "deployment_boundary"],
  "properties": {
    "schema_version": {"const": "atlas-model-promotion/public-projection-policy/v1"},
    "owner": {"const": "AtlasReaper311/atlas-infra"},
    "contract_schema": {"const": "contracts/v1/public-model-promotion-projection.schema.json"},
    "lifecycle_authority": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["ADR-0013", "ADR-0014"]}},
    "allowed_capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80}},
    "allowed_model_identifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$", "maxLength": 80}},
    "allowed_suite_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32}},
    "regression_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "categories"],
      "properties": {
        "schema_version": {"const": "atlas-control-plane/model-promotion-regression-vocabulary/v1"},
        "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["unsupported-fabrication", "failed-abstention", "grounding-failure", "unsupported-causal-claim", "format-contract-failure"]}}
      }
    },
    "public_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "production_artifact_registered", "target_registration"],
      "properties": {
        "mode": {"const": "schema-and-policy-only"},
        "production_artifact_registered": {"const": false},
        "target_registration": {"const": "deferred-until-artifact-exists"}
      }
    },
    "deployment_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_is_not_deployment", "deployment_state", "runtime_state", "live_state"],
      "properties": {
        "promotion_is_not_deployment": {"const": true},
        "deployment_state": {"const": "not-applicable"},
        "runtime_state": {"const": "not-applicable"},
        "live_state": {"const": "not-applicable"}
      }
    }
  }
}
