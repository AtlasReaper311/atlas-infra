  "component": {
    "role": "footer",
    "selector": ".atlas-footer",
    "semantic_element": "footer",
    "single_primary_footer_required": true,
    "accessible_name_required_when_multiple": true,
    "empty_footer_forbidden": true,
    "empty_slots_forbidden": true
  },
  "slots": {
    "identity": {
      "required": true,
      "purpose": "Names the owning estate, product, tool, section, or editorial surface.",
      "content_owner": "consumer"
    },
    "context": {
      "required": false,
      "purpose": "Provides purpose-specific local destinations without duplicating the complete global navigation.",
      "content_owner": "consumer"
    },
    "evidence": {
      "required": false,
      "purpose": "Links to relevant source, status, documentation, or operational evidence.",
      "content_owner": "consumer"
    },
    "sequence": {
      "required": false,
      "purpose": "Provides ordered previous and next navigation where the content model has a real sequence.",
      "content_owner": "consumer-or-publisher",
      "article_owner": "AtlasReaper311/atlas-scheduler"
    },
    "estate_escape": {
      "required": true,
      "purpose": "Provides a clear route from the local surface into the wider Atlas Systems estate.",
      "content_owner": "consumer"
    }
  },
  "variants": {
    "estate": {
      "required_slots": [
        "identity",
        "estate_escape"
      ],
      "optional_slots": [
        "context",
        "evidence"
      ],
      "forbidden_slots": [
        "sequence"
      ],
      "intended_surfaces": [
        "atlas-systems estate pages"
      ]
    },
    "product": {
      "required_slots": [
        "identity",
        "estate_escape"
      ],
      "optional_slots": [
        "context",
        "evidence"
      ],
      "forbidden_slots": [
        "sequence"
      ],
      "intended_surfaces": [
        "status",
        "public API docs",
        "Ramone",
        "CV"
      ]
    },
    "tool": {
      "required_slots": [
        "identity",
        "context",
        "estate_escape"
      ],
      "optional_slots": [
        "evidence"
      ],
      "forbidden_slots": [
        "sequence"
      ],
      "intended_surfaces": [
        "Lab tools and experiments"
      ]
    },
    "editorial": {
      "required_slots": [
        "identity",
        "sequence",
        "estate_escape"
      ],
      "optional_slots": [
        "context",
        "evidence"
      ],
      "forbidden_slots": [],
      "intended_surfaces": [
        "Writing articles and ordered editorial series"
      ]
    }
  },
  "intentional_differences": {
    "classic_writing_articles": {
      "status": "accepted",
      "decision": "docs/adrs/ADR-0009-classic-writing-footer-exception.md",
      "profile": "classic-writing-article-footer",
      "scope": {
        "surface": "published Writing article pages",
        "repositories": [
          "AtlasReaper311/atlas-article-gen",
          "AtlasReaper311/atlas-scheduler",
          "AtlasReaper311/atlas-systems"
        ],
        "permanent_series": [
          "W-01",
          "W-02",
          "W-03",
          "W-04",
          "W-05",
          "W-06",
          "W-07"
        ],
        "current_generator_output_until": "Phase 10 editorial surface review"
