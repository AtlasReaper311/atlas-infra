{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atlas-systems.uk/control-plane/v1/finding.schema.json",
  "title": "Atlas Systems Finding v1",
  "description": "A redacted, deduplicated assurance finding.",
  "type": "object",
  "additionalProperties": false,
  "x-owner": {
    "repository": "AtlasReaper311/atlas-infra",
    "consumer": "AtlasReaper311/atlas-dep-audit"
  },
  "required": ["schema_version", "source", "subject", "category", "severity", "rule_id", "location", "evidence", "detected_at", "fingerprint", "remediation"],
  "properties": {
    "schema_version": {"const": "atlas-control-plane/finding/v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "check_id", "producer_version"],
      "properties": {
        "producer": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
        "check_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
        "producer_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "pattern": "^AtlasReaper311/[A-Za-z0-9._-]+$", "maxLength": 128},
        "service_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64}
      }
    },
    "category": {"enum": ["availability", "backup", "contract", "cost", "dependency", "documentation", "evidence", "journey", "policy", "release", "runbook", "secret-hygiene", "security"]},
    "severity": {"enum": ["info", "warning", "failure", "critical"]},
    "rule_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
    "location": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+(?::[1-9][0-9]*)?$", "maxLength": 240},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "references", "redacted"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 500},
        "references": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://[^?#]+(?:#[A-Za-z0-9._/-]+)?$", "maxLength": 500}},
        "redacted": {"type": "boolean"}
      }
    },
    "detected_at": {"type": "string", "format": "date-time"},
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "reason"],
      "properties": {
        "eligible": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 240},
        "disposition": {"enum": ["remediation-available", "awaiting-upstream-release", "awaiting-upstream-fix", "manual-remediation-required", "unsupported-remediation"]},
        "candidate": {"oneOf": [{"$ref": "#/$defs/dependencyCandidate"}, {"$ref": "#/$defs/containerCandidate"}, {"$ref": "#/$defs/npmGraphCandidate"}]}
      }
    },
    "runbook_ref": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.md$", "maxLength": 240}
  },
  "$defs": {
    "dependencyCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ecosystem", "dependency", "current_version", "target_version", "source_file", "update_class", "direct", "vulnerability_ids"],
      "properties": {
        "kind": {"const": "dependency-update"},
        "ecosystem": {"enum": ["npm", "PyPI"]},
        "dependency": {"type": "string", "pattern": "^[A-Za-z0-9@._/-]+$", "minLength": 1, "maxLength": 160},
        "current_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9A-Za-z-]+)+$", "maxLength": 80},
        "target_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9A-Za-z-]+)+$", "maxLength": 80},
        "source_file": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 240},
        "update_class": {"enum": ["patch", "minor"]},
        "direct": {"const": true},
        "vulnerability_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 128}}
      }
    },
    "containerCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_file", "current_reference", "target_digest"],
      "properties": {
        "kind": {"const": "container-digest-pin"},
        "source_file": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 240},
        "current_reference": {"type": "string", "pattern": "^[A-Za-z0-9._/:@-]+$", "minLength": 1, "maxLength": 200},
        "target_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "npmGraphCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "manifest_file", "lockfile_file", "npm_version", "direct_updates", "transitive_updates", "vulnerability_ids", "target_manifest_sha256", "target_lockfile_sha256"],
      "properties": {
        "kind": {"const": "npm-lock-security-remediation"},
        "manifest_file": {"type": "string", "pattern": "^(?:[A-Za-z0-9._-]+/)*package\\.json$", "maxLength": 240},
        "lockfile_file": {"type": "string", "pattern": "^(?:[A-Za-z0-9._-]+/)*package-lock\\.json$", "maxLength": 240},
        "npm_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "maxLength": 40},
        "direct_updates": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/npmDirectUpdate"}},
        "transitive_updates": {"type": "array", "maxItems": 40, "uniqueItems": true, "items": {"$ref": "#/$defs/npmTransitiveUpdate"}},
        "vulnerability_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 128}},
        "target_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "target_lockfile_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "anyOf": [
        {"properties": {"direct_updates": {"type": "array", "minItems": 1}}},
        {"properties": {"transitive_updates": {"type": "array", "minItems": 1}}}
      ]
    },
    "npmDirectUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency", "section", "current_version", "target_version", "current_spec", "target_spec", "vulnerability_ids"],
      "properties": {
        "dependency": {"type": "string", "pattern": "^[A-Za-z0-9@._/-]+$", "minLength": 1, "maxLength": 160},
        "section": {"enum": ["dependencies", "devDependencies", "optionalDependencies"]},
        "current_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "target_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "current_spec": {"type": "string", "pattern": "^[~^]?[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 80},
        "target_spec": {"type": "string", "pattern": "^[~^]?[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 80},
        "vulnerability_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 128}}
      }
    },
    "npmTransitiveUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency", "package_path", "current_version", "target_version", "parents", "vulnerability_ids"],
      "properties": {
        "dependency": {"type": "string", "pattern": "^[A-Za-z0-9@._/-]+$", "minLength": 1, "maxLength": 160},
        "package_path": {"type": "string", "pattern": "^node_modules/(?:[A-Za-z0-9@._-]+/)*[A-Za-z0-9@._-]+$", "maxLength": 240},
        "current_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "target_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "parents": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/npmParentConstraint"}},
        "vulnerability_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 128}}
      }
    },
    "npmParentConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_path", "specifier"],
      "properties": {
        "package_path": {"type": "string", "pattern": "^node_modules/(?:[A-Za-z0-9@._-]+/)*[A-Za-z0-9@._-]+$", "maxLength": 240},
        "specifier": {"type": "string", "pattern": "^[0-9A-Za-z.*+<>=~^| -]+$", "minLength": 1, "maxLength": 100}
      }
    }
  },
  "examples": [{
    "schema_version": "atlas-control-plane/finding/v1",
    "source": {"producer": "atlas-dep-audit", "check_id": "contract-schema-invalid", "producer_version": "1.0.0"},
    "subject": {"repository": "AtlasReaper311/atlas-infra", "service_id": "atlas-infra"},
    "category": "contract",
    "severity": "failure",
    "rule_id": "schema-validation",
    "location": "contracts/v1/finding.schema.json",
    "evidence": {"summary": "A contract fixture failed validation.", "references": ["https://github.com/AtlasReaper311/atlas-infra/actions/runs/100"], "redacted": true},
    "detected_at": "2026-07-14T10:00:00Z",
    "fingerprint": "sha256:195f317331e98e586d17af0766b7096cd28262805db932538f3870dc5e73c25a",
    "remediation": {"eligible": false, "reason": "Schema governance changes require owner review.", "disposition": "manual-remediation-required"},
    "runbook_ref": "docs/runbooks/control-plane-contract-validation.md"
  }]
}
