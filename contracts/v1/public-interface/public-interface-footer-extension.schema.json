{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-systems.uk/contracts/v1/public-interface/public-interface-footer-extension.schema.json",
  "title": "Atlas Systems public interface footer extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "status",
    "authority",
    "evidence_basis",
    "component",
    "slots",
    "variants",
    "intentional_differences",
    "behaviour",
    "ownership",
    "distribution",
    "excluded"
  ],
  "properties": {
    "schema_version": {
      "const": "atlas-control-plane/public-interface-footer-extension/v1"
    },
    "version": {
      "const": "1.1.0"
    },
    "status": {
      "const": "accepted"
    },
    "authority": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "evidence_basis": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "component": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "context",
        "evidence",
        "sequence",
        "estate_escape"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/nonEmptyObject"
        },
        "context": {
          "$ref": "#/$defs/nonEmptyObject"
        },
        "evidence": {
          "$ref": "#/$defs/nonEmptyObject"
        },
        "sequence": {
          "$ref": "#/$defs/nonEmptyObject"
        },
        "estate_escape": {
          "$ref": "#/$defs/nonEmptyObject"
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estate",
        "product",
        "tool",
        "editorial"
      ],
      "properties": {
        "estate": {
          "$ref": "#/$defs/variant"
        },
        "product": {
          "$ref": "#/$defs/variant"
        },
        "tool": {
          "$ref": "#/$defs/variant"
        },
        "editorial": {
          "$ref": "#/$defs/variant"
        }
      }
    },
    "intentional_differences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classic_writing_articles"
      ],
      "properties": {
        "classic_writing_articles": {
          "$ref": "#/$defs/classicWritingArticles"
        }
      }
    },
    "behaviour": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "ownership": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "distribution": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "excluded": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "nonEmptyObject": {
      "type": "object",
      "minProperties": 1
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_slots",
        "optional_slots",
        "forbidden_slots",
        "intended_surfaces"
      ],
      "properties": {
        "required_slots": {
          "$ref": "#/$defs/slotList"
        },
        "optional_slots": {
          "$ref": "#/$defs/slotList"
        },
        "forbidden_slots": {
          "$ref": "#/$defs/slotList"
        },
        "intended_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "slotList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "context",
          "evidence",
          "sequence",
          "estate_escape"
        ]
      }
    },
    "classicWritingArticles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision",
        "profile",
        "scope",
        "required_structure",
        "forbidden_structure",
        "ownership",
        "non_transferable",
        "interface_kit_variant_created"
      ],
      "properties": {
        "status": {
          "const": "accepted"
        },
        "decision": {
          "const": "docs/adrs/ADR-0009-classic-writing-footer-exception.md"
        },
        "profile": {
          "const": "classic-writing-article-footer"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surface",
            "repositories",
            "permanent_series",
            "current_generator_output_until"
          ],
          "properties": {
            "surface": {
              "const": "published Writing article pages"
            },
            "repositories": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "enum": [
                  "AtlasReaper311/atlas-article-gen",
                  "AtlasReaper311/atlas-scheduler",
                  "AtlasReaper311/atlas-systems"
                ]
              }
            },
            "permanent_series": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "enum": [
                  "W-01",
                  "W-02",
                  "W-03",
                  "W-04",
                  "W-05",
                  "W-06",
                  "W-07"
                ]
              }
            },
            "current_generator_output_until": {
              "const": "Phase 10 editorial surface review"
            }
          }
        },
        "required_structure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "container_element",
            "container_selector",
            "single_scheduler_placeholder_required",
            "published_content"
          ],
          "properties": {
            "container_element": {
              "const": "div"
            },
            "container_selector": {
              "const": ".article-footer"
            },
            "single_scheduler_placeholder_required": {
              "const": true
            },
            "published_content": {
              "const": "scheduler-owned previous and next article links, or Latest article"
            }
          }
        },
        "forbidden_structure": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "enum": [
              ".atlas-footer",
              ".atlas-footer--editorial",
              ".atlas-footer__identity",
              ".atlas-footer__context",
              ".atlas-footer__sequence",
              ".atlas-footer__estate-escape"
            ]
          }
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shell",
            "sequence",
            "publication"
          ],
          "properties": {
            "shell": {
              "const": "AtlasReaper311/atlas-article-gen"
            },
            "sequence": {
              "const": "AtlasReaper311/atlas-scheduler"
            },
            "publication": {
              "const": "AtlasReaper311/atlas-scheduler"
            }
          }
        },
        "non_transferable": {
          "const": true
        },
        "interface_kit_variant_created": {
          "const": false
        }
      }
    }
  }
}
