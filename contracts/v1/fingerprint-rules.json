{
  "schema_version": "atlas-control-plane/fingerprint-rules/v1",
  "canonicalization": {
    "encoding": "UTF-8",
    "json": "RFC 8259 object with lexicographically sorted keys and compact separators",
    "unicode": "preserved without ASCII escaping",
    "digest": "SHA-256 lowercase hexadecimal"
  },
  "rules": {
    "evidence-envelope": {
      "kind": "payload-digest",
      "schema": "evidence-envelope.schema.json",
      "content_path": "payload",
      "output_path": "digest.value"
    },
    "finding": {
      "kind": "selected-fields",
      "schema": "finding.schema.json",
      "fields": [
        "source.producer",
        "source.check_id",
        "subject.repository",
        "subject.service_id",
        "category",
        "rule_id",
        "location"
      ],
      "sort_arrays": [],
      "prefix": "sha256:",
      "output_path": "fingerprint"
    },
    "remediation-proposal": {
      "kind": "selected-fields",
      "schema": "remediation-proposal.schema.json",
      "fields": [
        "finding_fingerprint",
        "fixer.id",
        "fixer.version",
        "files_affected",
        "patch_digest"
      ],
      "sort_arrays": [
        "files_affected"
      ],
      "prefix": "proposal:sha256:",
      "output_path": "proposal_id"
    },
    "twin-impact-projection": {
      "kind": "selected-fields",
      "schema": "twin-impact-projection.schema.json",
      "fields": [
        "schema_version",
        "generated_at",
        "subject",
        "impact.conclusion",
        "impact.scope",
        "impact.coverage",
        "impact.relationships",
        "impact.unknowns",
        "analysis",
        "provenance",
        "distribution",
        "privacy",
        "limitations"
      ],
      "sort_arrays": [
        "impact.relationships",
        "impact.unknowns",
        "limitations"
      ],
      "prefix": "sha256:",
      "output_path": "projection_fingerprint"
    },
    "public-model-promotion-projection": {
      "kind": "selected-fields",
      "schema": "public-model-promotion-projection.schema.json",
      "fields": [
        "schema_version",
        "generated_at",
        "state",
        "capability.id",
        "model.public_id",
        "evaluation.state",
        "evaluation.suite.version",
        "evaluation.suite.revision",
        "evaluation.prepared_at",
        "evaluation.evaluated_at",
        "evaluation.categories",
        "evaluation.known_regressions.vocabulary_version",
        "evaluation.known_regressions.state",
        "evaluation.known_regressions.categories",
        "evaluation.result.case_count",
        "evaluation.result.passed_count",
        "evaluation.result.failed_count",
        "evaluation.result.pass_rate",
        "evaluation.result.minimum_pass_rate",
        "human_review.state",
        "human_review.reviewed_at",
        "promotion.state",
        "promotion.approved_at",
        "promotion.supersedes_projection_fingerprint",
        "promotion.superseded_by_projection_fingerprint",
        "freshness.state",
        "freshness.evidence_observed_at",
        "freshness.max_age_days",
        "current_model_observation.subject",
        "current_model_observation.state",
        "current_model_observation.observed_model_id",
        "current_model_observation.observed_at",
        "gaps",
        "deployment_boundary.promotion_is_not_deployment",
        "deployment_boundary.deployment_observed",
        "deployment_boundary.deployed",
        "deployment_boundary.runtime_verified",
        "deployment_boundary.live_verified",
        "privacy.mode",
        "privacy.private_inputs_excluded",
        "privacy.unknown_fields_rejected",
        "privacy.private_evidence_uris_excluded",
        "privacy.runtime_configuration_excluded",
        "privacy.raw_answers_excluded"
      ],
      "sort_arrays": [
        "evaluation.categories",
        "evaluation.known_regressions.categories",
        "gaps"
      ],
      "prefix": "sha256:",
      "output_path": "projection_fingerprint"
    }
  },
  "trace_rules": {
    "evidence-node": {
      "kind": "selected-fields",
      "schema": "evidence-node.schema.json",
      "fields": [
        "kind",
        "identity.key"
      ],
      "sort_arrays": [],
      "prefix": "node:sha256:",
      "output_path": "node_id"
    },
    "evidence-edge": {
      "kind": "selected-fields",
      "schema": "evidence-edge.schema.json",
      "fields": [
        "from_node",
        "relation",
        "to_node"
      ],
      "sort_arrays": [],
      "prefix": "edge:sha256:",
      "output_path": "edge_id"
    },
    "evidence-graph": {
      "kind": "selected-fields",
      "schema": "evidence-graph.schema.json",
      "fields": [
        "visibility",
        "nodes",
        "edges"
      ],
      "sort_arrays": [
        "nodes",
        "edges"
      ],
      "prefix": "graph:sha256:",
      "output_path": "fingerprint"
    }
  },
  "wave3_rules": {
    "retirement-evidence": {
      "kind": "selected-fields",
      "schema": "retirement-evidence.schema.json",
      "fields": [
        "subject",
        "state",
        "evidence",
        "visibility",
        "recorded_at",
        "approved_by"
      ],
      "sort_arrays": [],
      "prefix": "retirement:sha256:",
      "output_path": "retirement_id"
    },
    "adr-runtime-relationship": {
      "kind": "selected-fields",
      "schema": "adr-runtime-relationship.schema.json",
      "fields": [
        "adr",
        "affects.repositories",
        "affects.services",
        "affects.contracts",
        "affects.policies",
        "visibility"
      ],
      "sort_arrays": [
        "affects.repositories",
        "affects.services",
        "affects.contracts",
        "affects.policies"
      ],
      "prefix": "adrrel:sha256:",
      "output_path": "relationship_id"
    },
    "model-promotion": {
      "kind": "selected-fields",
      "schema": "model-promotion.schema.json",
      "fields": [
        "capability",
        "model",
        "configuration",
        "evaluation",
        "approval",
        "visibility"
      ],
      "sort_arrays": [],
      "prefix": "promotion:sha256:",
      "output_path": "promotion_id"
    }
  }
}
