{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atlas-systems.uk/control-plane/v1/remediation-proposal.schema.json",
  "title": "Atlas Systems RemediationProposal v1",
  "description": "A reviewable remediation plan with inert validation commands and optional structured deterministic input.",
  "type": "object",
  "additionalProperties": false,
  "x-owner": {"repository": "AtlasReaper311/atlas-infra", "consumer": "AtlasReaper311/atlas-gardener"},
  "required": ["schema_version", "proposal_id", "finding_fingerprint", "fixer", "files_affected", "risk_class", "patch_digest", "validation_plan", "rollback_plan", "expires_at"],
  "properties": {
    "schema_version": {"const": "atlas-control-plane/remediation-proposal/v1"},
    "proposal_id": {"type": "string", "pattern": "^proposal:sha256:[0-9a-f]{64}$"},
    "finding_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fixer": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "files_affected": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 240}},
    "risk_class": {"enum": ["low", "medium", "high"]},
    "patch_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "remediation_input": {"oneOf": [{"$ref": "#/$defs/dependencyCandidate"}, {"$ref": "#/$defs/containerCandidate"}, {"$ref": "#/$defs/npmGraphCandidate"}]},
    "validation_plan": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["check_id", "command", "expected"], "properties": {"check_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64}, "command": {"type": "string", "pattern": "^[A-Za-z0-9_./:= -]+$", "minLength": 1, "maxLength": 240}, "expected": {"type": "string", "minLength": 1, "maxLength": 240}}}},
    "rollback_plan": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "dependencyCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ecosystem", "dependency", "current_version", "target_version", "source_file", "update_class", "direct", "vulnerability_ids"],
      "properties": {
        "kind": {"const": "dependency-update"},
        "ecosystem": {"enum": ["npm", "PyPI"]},
        "dependency": {"type": "string", "pattern": "^[A-Za-z0-9@._/-]+$", "minLength": 1, "maxLength": 160},
        "current_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9A-Za-z-]+)+$", "maxLength": 80},
        "target_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9A-Za-z-]+)+$", "maxLength": 80},
        "source_file": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 240},
        "update_class": {"enum": ["patch", "minor"]},
        "direct": {"const": true},
        "vulnerability_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 128}}
      }
    },
    "containerCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_file", "current_reference", "target_digest"],
      "properties": {
        "kind": {"const": "container-digest-pin"},
        "source_file": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 240},
        "current_reference": {"type": "string", "pattern": "^[A-Za-z0-9._/:@-]+$", "minLength": 1, "maxLength": 200},
        "target_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "npmGraphCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "manifest_file", "lockfile_file", "npm_version", "direct_updates", "transitive_updates", "vulnerability_ids", "target_manifest_sha256", "target_lockfile_sha256"],
      "properties": {
        "kind": {"const": "npm-lock-security-remediation"},
        "manifest_file": {"type": "string", "pattern": "^(?:[A-Za-z0-9._-]+/)*package\\.json$", "maxLength": 240},
        "lockfile_file": {"type": "string", "pattern": "^(?:[A-Za-z0-9._-]+/)*package-lock\\.json$", "maxLength": 240},
        "npm_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "maxLength": 40},
        "direct_updates": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/npmDirectUpdate"}},
        "transitive_updates": {"type": "array", "maxItems": 40, "uniqueItems": true, "items": {"$ref": "#/$defs/npmTransitiveUpdate"}},
        "vulnerability_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 128}},
        "target_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "target_lockfile_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "anyOf": [
        {"properties": {"direct_updates": {"type": "array", "minItems": 1}}},
        {"properties": {"transitive_updates": {"type": "array", "minItems": 1}}}
      ]
    },
    "npmDirectUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency", "section", "current_version", "target_version", "current_spec", "target_spec", "vulnerability_ids"],
      "properties": {
        "dependency": {"type": "string", "pattern": "^[A-Za-z0-9@._/-]+$", "minLength": 1, "maxLength": 160},
        "section": {"enum": ["dependencies", "devDependencies", "optionalDependencies"]},
        "current_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "target_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "current_spec": {"type": "string", "pattern": "^[~^]?[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 80},
        "target_spec": {"type": "string", "pattern": "^[~^]?[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 80},
        "vulnerability_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 128}}
      }
    },
    "npmTransitiveUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency", "package_path", "current_version", "target_version", "parents", "vulnerability_ids"],
      "properties": {
        "dependency": {"type": "string", "pattern": "^[A-Za-z0-9@._/-]+$", "minLength": 1, "maxLength": 160},
        "package_path": {"type": "string", "pattern": "^node_modules/(?:[A-Za-z0-9@._-]+/)*[A-Za-z0-9@._-]+$", "maxLength": 240},
        "current_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "target_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "parents": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/npmParentConstraint"}},
        "vulnerability_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 128}}
      }
    },
    "npmParentConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_path", "specifier"],
      "properties": {
        "package_path": {"type": "string", "pattern": "^node_modules/(?:[A-Za-z0-9@._-]+/)*[A-Za-z0-9@._-]+$", "maxLength": 240},
        "specifier": {"type": "string", "pattern": "^[0-9A-Za-z.*+<>=~^| -]+$", "minLength": 1, "maxLength": 100}
      }
    }
  },
  "examples": [{
    "schema_version": "atlas-control-plane/remediation-proposal/v1",
    "proposal_id": "proposal:sha256:7f4b0b3abed2ee3bd7b3a291155aad38df2539d648394bd74ca704324b837ec5",
    "finding_fingerprint": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
    "fixer": {"id": "add-ds-store-ignore", "version": "1.0.0"},
    "files_affected": [".gitignore"],
    "risk_class": "low",
    "patch_digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
    "validation_plan": [{"check_id": "repository-tests", "command": "python3 -m unittest discover -s tests -v", "expected": "All repository tests pass."}],
    "rollback_plan": ["Close the unmerged review branch and leave main unchanged."],
    "expires_at": "2026-07-21T10:00:00Z"
  }]
}
